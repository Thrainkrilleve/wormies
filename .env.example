# ==============================================================================
# Wormhole Systems — Configuration Template
# Copy this file to .env and adjust the values below:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Domain Settings
# ------------------------------------------------------------------------------
APP_NAME="Wormhole Systems"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://wormhole.yourdomain.com
APP_PORT=8090

# Generate with: docker compose exec app php artisan key:generate
APP_KEY=

# CCP ESI requires contact info on third-party apps to avoid API rate limiting/blocks.
# Format: "your-email@example.com | Main EVE Character" (Same as your Alliance Auth contact)
CONTACT_EMAIL="you@example.com | Main EVE Character"

# ------------------------------------------------------------------------------
# 2. Alliance Auth Single Sign-On (OIDC)
# ------------------------------------------------------------------------------
# In Alliance Auth Admin (/admin/) > AllianceAuth OIDC > Applications > Add Application:
#   - Client Type: Confidential
#   - Authorization Grant Type: Authorization code
#   - Redirect URIs: https://wormhole.yourdomain.com/auth/allianceauth/callback
#   - Algorithm: RS256
#   - Skip Authorization: True
ALLIANCEAUTH_ENABLED=true
ALLIANCEAUTH_BASE_URL="https://auth.yourdomain.com"
ALLIANCEAUTH_CLIENT_ID=your_client_id_from_aa_admin
ALLIANCEAUTH_CLIENT_SECRET=your_client_secret_from_aa_admin
ALLIANCEAUTH_CALLBACK="https://wormhole.yourdomain.com/auth/allianceauth/callback"
ALLIANCEAUTH_ONLY=true

# (Optional) Restrict access to specific Alliance Auth group names (comma-separated)
# Leave empty to allow any authenticated member
ALLIANCEAUTH_REQUIRED_GROUPS=

# ------------------------------------------------------------------------------
# 3. Shared EVE Developer Application Credentials
# ------------------------------------------------------------------------------
# You DO NOT need to create a second app on developers.eveonline.com!
# Simply copy the existing ESI_SSO_CLIENT_ID & ESI_SSO_CLIENT_SECRET from your Alliance Auth local.py / .env:
EVE_CLIENT_ID=your_alliance_auth_esi_sso_client_id
EVE_CLIENT_SECRET=your_alliance_auth_esi_sso_client_secret
EVE_CALLBACK="https://wormhole.yourdomain.com/eve/callback"

# ------------------------------------------------------------------------------
# 4. Real-time Map WebSockets (Laravel Reverb)
# ------------------------------------------------------------------------------
# Host port exposed for your reverse proxy or Cloudflare Tunnel (point ws.wormhole.yourdomain.com here)
REVERB_PORT=8091

# Random secret keys for Reverb (generate any random string, e.g. openssl rand -hex 16)
REVERB_APP_ID=wormholesystems
REVERB_APP_KEY=change_this_to_a_random_key
REVERB_APP_SECRET=change_this_to_a_random_secret

# Client connection details used by browser frontend
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="ws.wormhole.yourdomain.com"
VITE_REVERB_PORT="443"
VITE_REVERB_SCHEME="https"

# Internal container networking
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_BEHIND_PROXY=true
BROADCAST_CONNECTION=reverb

# ------------------------------------------------------------------------------
# 5. Database & Cache (Managed automatically by Docker)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=wormholesystems
DB_USERNAME=wormholesystems
DB_PASSWORD=change_this_secure_password

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
CACHE_PREFIX=ws_

# Internal Laravel defaults
SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=info
