# ==============================================================================
# Wormhole Systems Configuration for Cloudflare Tunnels & Alliance Auth
# Copy this file to .env before running docker compose
# ==============================================================================

# Application URLs & Domains
APP_NAME="Wormhole Systems"
APP_ENV=production
APP_DEBUG=false
APP_DOMAIN=wormhole.r3v-w.space
APP_URL=https://wormhole.r3v-w.space

# Host ports to expose to Cloudflare Tunnel (cloudflared)
APP_HOST_PORT=8090
REVERB_HOST_PORT=8091

# Needed for FrankenPHP / Caddy behind Cloudflare Tunnel
SERVER_NAME=:80

# Generate with: docker compose -f docker-compose.cloudflare.yml exec app php artisan key:generate
APP_KEY=

# CCP ESI Contact Info - MUST be populated to avoid API blocks
CONTACT_EMAIL="you@example.com | Your Main EVE Character"

# Database Configuration (Must match dockerfiles/mysql/.env)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=wormholesystems
DB_USERNAME=wormholesystems
DB_PASSWORD=change_this_secure_password

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
CACHE_PREFIX=ws_

# ==============================================================================
# Alliance Auth OIDC SSO Configuration
# ==============================================================================
ALLIANCEAUTH_ENABLED=true
ALLIANCEAUTH_BASE_URL="https://auth.r3v-w.space"
ALLIANCEAUTH_CLIENT_ID=fill_with_client_id_from_alliance_auth_admin
ALLIANCEAUTH_CLIENT_SECRET=fill_with_client_secret_from_alliance_auth_admin
ALLIANCEAUTH_CALLBACK="https://wormhole.r3v-w.space/auth/allianceauth/callback"

# (Optional) Comma-separated list of Alliance Auth group names or states required to access maps.
# Leave empty to allow any authenticated Alliance Auth member.
# Example: ALLIANCEAUTH_REQUIRED_GROUPS="Member,Wormhole Ops"
ALLIANCEAUTH_REQUIRED_GROUPS=

# Set to true if you want visiting /login to directly redirect to Alliance Auth
ALLIANCEAUTH_ONLY=false

# ==============================================================================
# Native EVE Online SSO (Optional fallback)
# ==============================================================================
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK="https://wormhole.r3v-w.space/eve/callback"

# Optional affiliation whitelist (leave empty when using Alliance Auth groups)
ALLOWED_AFFILIATION_IDS=

# ==============================================================================
# Reverb (WebSockets for real-time map updates)
# ==============================================================================
# Generate long random strings for these (e.g. openssl rand -hex 16)
REVERB_APP_ID=wormholesystems
REVERB_APP_KEY=reverb_key_change_me
REVERB_APP_SECRET=reverb_secret_change_me

# Client connection details used by Vue/Inertia frontend in the browser
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="ws.wormhole.r3v-w.space"
VITE_REVERB_PORT="443"
VITE_REVERB_SCHEME="https"

# Internal container connection
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_BEHIND_PROXY=true
BROADCAST_CONNECTION=reverb

# Core internals
SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
PHP_CLI_SERVER_WORKERS=4
LOG_CHANNEL=stack
LOG_LEVEL=info
